# Copier en .env et ajuster. Le .env n'est JAMAIS versionne.
# Les valeurs par defaut font tourner le projet entierement en local :
# aucune donnee, pas meme le profil, ne quitte le poste.

# --- Modele de langage ----------------------------------------------------
# ollama (local, defaut) | anthropic | openai
LLM_PROVIDER=ollama
# Modele de generation de code. qwen2.5-coder:14b (~9 Go) tient sur un GPU 12 Go.
# Postes plus modestes : qwen2.5-coder:7b (~4,7 Go).
LLM_MODEL=qwen2.5-coder:14b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=180

# Uniquement si LLM_PROVIDER pointe vers un fournisseur distant.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Garde-fous du run ----------------------------------------------------
# Plafonds de depart, a ajuster avec Wavestone.
MAX_ITERATIONS=5
MAX_TOKENS_BUDGET=200000

# Validation humaine du plan au premier passage (true) ou bout-en-bout (false)
HUMAN_VALIDATION=true

# --- Sandbox d'execution --------------------------------------------------
SANDBOX_IMAGE=agent-data-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPUS=2.0

# --- Observabilite (Langfuse, optionnel) ----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
