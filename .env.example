# Copier en .env et renseigner. Le .env n'est JAMAIS versionne.

# --- Fournisseur de LLM ---------------------------------------------------
# Choix non tranche (decision ouverte cote Wavestone) : API proprietaire vs modele local.
# Valeurs possibles : anthropic | openai | local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Clef requise selon LLM_PROVIDER (laisser vide celles qui ne servent pas)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Pour LLM_PROVIDER=local : URL du serveur compatible OpenAI (ex. Ollama, vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# --- Garde-fous du run ----------------------------------------------------
# Plafonds non tranches : valeurs de depart, a ajuster avec Wavestone.
MAX_ITERATIONS=5
MAX_TOKENS_BUDGET=200000

# Validation humaine du plan au premier passage (true) ou bout-en-bout (false)
HUMAN_VALIDATION=true

# --- Sandbox d'execution --------------------------------------------------
SANDBOX_IMAGE=agent-data-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=1g

# --- Observabilite (Langfuse, optionnel) ----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
